# Future server-only integrations — never expose these with NEXT_PUBLIC_ prefixes
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=replace-with-a-long-random-secret
PRIVATE_UPLOAD_BUCKET=
PRIVATE_UPLOAD_REGION=
PRIVATE_UPLOAD_ACCESS_KEY_ID=
PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
